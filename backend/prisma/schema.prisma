generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER_PILOT
  ADMIN
  DEPARTMENT
}

enum DepartmentType {
  ENGINEERING
  TRACTION_DISTRIBUTION
  SIGNAL_TELECOM
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  SCHEDULED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SegmentStatus {
  NORMAL
  OCCUPIED
  PLANNED_POSSESSION
  DISRUPTED
  CONFLICT
}

model User {
  id              String          @id @default(cuid())
  fullName        String
  employeeId      String          @unique
  email           String          @unique
  mobileNumber    String
  passwordHash    String
  role            Role
  department      DepartmentType?
  assignedTrainId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  reportedRequests MaintenanceRequest[] @relation("ReportedByUser")
  reviewedRequests MaintenanceRequest[] @relation("ReviewedByUser")
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model Station {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  lat       Float
  lon       Float
  type      String   // junction | station | yard
  createdAt DateTime @default(now())

  fromSegments TrackSegment[] @relation("FromStation")
  toSegments   TrackSegment[] @relation("ToStation")
}

model TrackSegment {
  id            String        @id @default(cuid())
  fromStationId String
  toStationId   String
  label         String        // e.g. "Rajahmundry–Samalkot Jn"
  status        SegmentStatus @default(NORMAL)
  lengthKm      Float         @default(35.0)
  isSingleLine  Boolean       @default(false)
  createdAt     DateTime      @default(now())

  fromStation Station @relation("FromStation", fields: [fromStationId], references: [id])
  toStation   Station @relation("ToStation", fields: [toStationId], references: [id])

  maintenanceRequests MaintenanceRequest[]
}

model MaintenanceRequest {
  id                    String           @id @default(cuid())
  reportedById          String
  reportingDepartment   DepartmentType
  requiredDepartments   DepartmentType[]
  segmentId             String
  title                 String
  description           String
  photoUrls             String[]
  observedAt            DateTime
  estimatedDelayMinutes Int
  severity              Severity
  priorityScore         Float?
  status                RequestStatus    @default(SUBMITTED)
  scheduledStart        DateTime?
  scheduledEnd          DateTime?
  assignedCrewId        String?
  reviewedById          String?
  xaiExplanation        Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  reportedBy User         @relation("ReportedByUser", fields: [reportedById], references: [id])
  reviewedBy User?        @relation("ReviewedByUser", fields: [reviewedById], references: [id])
  segment    TrackSegment @relation(fields: [segmentId], references: [id])

  auditLogs AuditLog[]
}

model Notification {
  id               String   @id @default(cuid())
  userId           String
  type             String   // request_submitted | request_scheduled | block_alert | status_change
  message          String
  relatedRequestId String?
  isRead           Boolean  @default(false)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id               String   @id @default(cuid())
  actorId          String
  action           String
  beforeState      Json?
  afterState       Json?
  relatedRequestId String?
  createdAt        DateTime @default(now())

  actor          User                @relation(fields: [actorId], references: [id])
  relatedRequest MaintenanceRequest? @relation(fields: [relatedRequestId], references: [id])
}

model Train {
  id                   String   @id @default(cuid())
  number               String   @unique
  name                 String
  pilotUserId          String?
  originStationId      String
  destinationStationId String
  currentSegmentId     String?
  status               String   @default("on_time") // on_time | delayed | held
  delayMinutes         Int      @default(0)
  createdAt            DateTime @default(now())
}
