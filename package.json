{
  "name": "railsync-ai",
  "version": "1.0.0",
  "description": "AI-Powered Automatic Block Planning to Maximize Asset Availability for Train Operations on Indian Railways",
  "scripts": {
    "postinstall": "npm --prefix frontend install && npm --prefix backend install",
    "start": "npm --prefix backend run start:prod",
    "start:prod": "npm --prefix backend run start:prod",
    "start:backend": "npm --prefix backend run start:prod",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "npm --prefix backend run test:e2e"
  },
  "keywords": ["railway", "ai", "block-planning", "indian-railways", "sih"],
  "author": "RailSync Team",
  "license": "ISC"
}
